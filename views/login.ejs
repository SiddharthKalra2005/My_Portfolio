<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Login | Siddharth Kalra</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: #f8f9fa;
        }
        .container-custom {
            max-width: 450px;
            margin: 0 auto;
            padding: 10vh 1rem;
        }
        .accent-font, .form-label, .btn {
            font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
        }
        .form-label {
            font-size: 0.85rem;
            letter-spacing: 0.5px;
        }
    </style>
</head>
<body>
    <div class="container-custom">
        <div class="text-center mb-5">
            <h2 class="fw-bold m-0">Admin Access</h2>
            <a href="/" class="text-muted text-decoration-none accent-font" style="font-size: 0.85rem;">← Back to Site</a>
        </div>
        
        <div class="card shadow-sm border-0 rounded-3">
            <div class="card-body p-5">
                <% if (typeof error !== 'undefined') { %>
                    <div class="alert alert-danger accent-font py-2 text-center mb-4" style="font-size: 0.85rem;"><%= error %></div>
                <% } %>

                <form action="/login" method="POST">
                    <div class="mb-4">
                        <label for="username" class="form-label text-muted text-uppercase fw-bold">Username</label>
                        <input type="text" class="form-control bg-light border-0 py-2" id="username" name="username" required>
                    </div>
                    
                    <div class="mb-5">
                        <label for="password" class="form-label text-muted text-uppercase fw-bold">Password</label>
                        <input type="password" class="form-control bg-light border-0 py-2" id="password" name="password" required>
                    </div>
                    
                    <button type="submit" class="btn btn-dark w-100 py-3 fw-bold">Authenticate</button>
                </form>
            </div>
        </div>
    </div>
</body>
</html>