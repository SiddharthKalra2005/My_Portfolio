<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Admin Dashboard</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
    <div class="container py-5" style="max-width: 600px;">
        <h2 class="mb-4 fw-bold">Add New Project</h2>
        <form action="/admin/add" method="POST" class="card p-4 shadow-sm border-0">
            <div class="mb-3">
                <label class="form-label fw-semibold">Title</label>
                <input type="text" name="title" class="form-control" required>
            </div>
            <div class="mb-3">
                <label class="form-label fw-semibold">Description</label>
                <textarea name="description" class="form-control" rows="3" required></textarea>
            </div>
            <div class="mb-3">
                <label class="form-label fw-semibold">Tech Stack (comma separated)</label>
                <input type="text" name="techStack" class="form-control" placeholder="e.g., Python, Flask, React" required>
            </div>
            <div class="mb-3">
                <label class="form-label fw-semibold">GitHub Repository Link</label>
                <input type="url" name="githubLink" class="form-control" required>
            </div>
            <button type="submit" class="btn btn-dark w-100 mt-2">Save Project</button>
        </form>
    </div>
</body>
