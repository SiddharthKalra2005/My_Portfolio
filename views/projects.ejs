<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Projects | Siddharth Kalra</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    
    <style>
        :root {
            --sans-font: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            --mono-font: ui-monospace, SFMono-Regular, Consolas, "Courier New", monospace;
        }

        body {
            font-family: var(--sans-font) !important;
            background-color: #fcfcfc;
            color: #1a1a1a;
            -webkit-font-smoothing: antialiased;
        }

        p, h2, h3, h4, h5, h6, span, div {
            font-family: var(--sans-font) !important;
        }

        h2.section-title {
            font-size: 2.25rem !important;
            font-weight: 800 !important;
            letter-spacing: -0.03em !important;
            color: #111 !important;
        }

        .card-title {
            font-weight: 700 !important;
            letter-spacing: -0.02em !important;
        }

        .navbar-brand,
        .nav-link,
        .btn,
        .badge {
            font-family: var(--mono-font) !important;
            letter-spacing: 0 !important;
        }

        .projects-container {
            max-width: 1000px !important;
            margin: 0 auto;
        }

        .card { 
            transition: transform 0.2s ease, box-shadow 0.2s ease; 
        }
        .card:hover {
            transform: translateY(-4px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.08) !important;
        }
    </style>
</head>
<body class="pb-5">
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-5">
        <div class="container">
            <a class="navbar-brand fw-bold" href="/" style="font-size: 0.95rem;">Siddharth Kalra</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto" style="font-size: 0.9rem;">
                    <li class="nav-item"><a class="nav-link" href="/">home</a></li>
                    <li class="nav-item"><a class="nav-link active text-white" href="/projects">projects</a></li>
                    <li class="nav-item"><a class="nav-link" href="/resume">resume</a></li>
                    <li class="nav-item"><a class="nav-link" href="https://github.com/SiddharthKalra2005" target="_blank" rel="noreferrer">github</a></li>
                </ul>
            </div>
        </div>
    </nav>

    <section class="container projects-container px-3">
        <h2 class="text-center mb-5 section-title">My Projects</h2>
        <div class="row g-4">
            <% projects.forEach(project => { %>
                <div class="col-md-4">
                    <div class="card h-100 shadow-sm border-0 rounded-3">
                        <div class="card-body d-flex flex-column p-4">
                            <h5 class="card-title mb-3 fs-5"><%= project.title %></h5>
                            <p class="card-text text-muted flex-grow-1" style="font-size: 0.95rem; line-height: 1.6;">
                                <%= project.description %>
                            </p>
                            <div class="mb-4">
                                <% project.techStack.forEach(tech => { %>
                                    <span class="badge bg-secondary me-1 fw-medium" style="font-size: 0.75rem;"><%= tech %></span>
                                <% }) %>
                            </div>
                            <a href="<%= project.githubLink %>" target="_blank" class="btn btn-dark mt-auto rounded-1 fw-medium" style="font-size: 0.85rem;">View on GitHub</a>
                        </div>
                    </div>
                </div>
            <% }) %>
        </div>
    </section>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>