<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Siddharth Kalra | Portfolio</title>
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
    <!-- Navigation Bar -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand" href="#">Siddharth Kalra</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item"><a class="nav-link" href="#about">About</a></li>
                    <li class="nav-item"><a class="nav-link" href="#skills">Skills</a></li>
                    <li class="nav-item"><a class="nav-link" href="#projects">Projects</a></li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Hero Section -->
    <header class="bg-light py-5 text-center">
        <div class="container my-5">
            <h1 class="display-4 fw-bold">Hi, I'm Siddharth</h1>
            <p class="lead mb-4">Undergraduate B.Tech student in Mathematics and Computing at Delhi Technological University.</p>
            <a href="#projects" class="btn btn-primary btn-lg">View My Work</a>
        </div>
    </header>
    <!-- Skills Section -->
    <section id="skills" class="py-5">
        <div class="container">
            <h2 class="text-center mb-5 fw-bold">Technical Skills</h2>
            <div class="row g-4">
                <!-- Skill Card 1 -->
                <div class="col-md-4">
                    <div class="card h-100 shadow-sm border-0 bg-light">
                        <div class="card-body text-center">
                            <h5 class="card-title fw-bold mb-3">Languages</h5>
                            <p class="card-text text-muted">C, C++, Python, JavaScript, SQL</p>
                        </div>
                    </div>
                </div>
                <!-- Skill Card 2 -->
                <div class="col-md-4">
                    <div class="card h-100 shadow-sm border-0 bg-light">
                        <div class="card-body text-center">
                            <h5 class="card-title fw-bold mb-3">Web Technologies</h5>
                            <p class="card-text text-muted">Node.js, Express.js, MongoDB, EJS, HTML/CSS</p>
                        </div>
                    </div>
                </div>
                <!-- Skill Card 3 -->
                <div class="col-md-4">
                    <div class="card h-100 shadow-sm border-0 bg-light">
                        <div class="card-body text-center">
                            <h5 class="card-title fw-bold mb-3">ML & Data Science</h5>
                            <p class="card-text text-muted">TensorFlow, Keras, PyTorch, OpenCV, scikit-learn</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Achievements Section -->
    <section id="about" class="py-5 bg-dark text-white">
        <div class="container">
            <h2 class="text-center mb-5 fw-bold">Achievements & Extras</h2>
            <div class="row justify-content-center">
                <div class="col-lg-8">
                    <ul class="list-group list-group-flush fs-5">
                        <li class="list-group-item bg-transparent text-white border-secondary py-3">
                            🚀 Secured 98.26 percentile in JEE Main (AIR 20,175).
                        </li>
                        <li class="list-group-item bg-transparent text-white border-secondary py-3">
                            💻 Solved 500+ DSA problems across competitive programming platforms.
                        </li>
                        <li class="list-group-item bg-transparent text-white border-secondary py-3">
                            ♟️ Active competitive chess player (~1500 Rapid) and Zonal Badminton medalist.
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </section>
    <!-- Projects Section -->
    <section id="projects" class="py-5">
        <div class="container">
            <h2 class="text-center mb-5 fw-bold">My Projects</h2>
            <div class="row g-4">
                <!-- EJS Loop Starts Here -->
                <% projects.forEach(project => { %>
                    <div class="col-md-4">
                        <div class="card h-100 shadow-sm border-0 bg-light">
                            <div class="card-body d-flex flex-column">
                                <h5 class="card-title fw-bold mb-3"><%= project.title %></h5>
                                <p class="card-text text-muted flex-grow-1"><%= project.description %></p>
                                
                                <!-- Loop through the tech stack array -->
                                <div class="mb-4">
                                    <% project.techStack.forEach(tech => { %>
                                        <span class="badge bg-secondary me-1"><%= tech %></span>
                                    <% }) %>
                                </div>
                                
                                <a href="<%= project.githubLink %>" target="_blank" class="btn btn-dark mt-auto">View on GitHub</a>
                            </div>
                        </div>
                    </div>
                <% }) %>
                <!-- EJS Loop Ends Here -->
            </div>
        </div>
    </section>
    <!-- Bootstrap JS bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</body>
</html>