<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Siddharth Kalra | Portfolio</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    
    <!-- Using Plus Jakarta Sans (The exact modern sleek font family used by top developer portfolios) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    
    <style>
        :root {
            --sans-font: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            --mono-font: ui-monospace, SFMono-Regular, Consolas, "Courier New", monospace;
        }

        body {
            font-family: var(--sans-font) !important;
            background-color: #fcfcfc;
            color: #1a1a1a;
            -webkit-font-smoothing: antialiased;
        }

        p, h2, h3, h4, h5, h6, span, div {
            font-family: var(--sans-font) !important;
        }

        /* 
           THE SLEEK MODERN HEADER:
           Instead of blocky bold, we use a clean 800 weight with balanced tracking.
        */
        h1.main-heading {
            font-family: var(--sans-font) !important;
            font-size: 3.5rem !important; 
            font-weight: 800 !important; 
            letter-spacing: -0.035em !important; 
            color: #111 !important;
            line-height: 1.15 !important;
        }
        
        h2.section-title {
            font-size: 1.75rem !important;
            font-weight: 700 !important;
            letter-spacing: -0.02em !important;
            margin-bottom: 1.5rem; 
        }

        /* Strict Monospace Targeting */
        .navbar-brand,
        .nav-link,
        .btn,
        .badge,
        .custom-bullet li,
        .mono-text {
            font-family: var(--mono-font) !important;
            letter-spacing: 0 !important;
        }

        /* Layout Utilities */
        .home-container { 
            max-width: 1000px !important; 
            margin: 0 auto; 
        }
        
        .profile-img { width: 100%; max-width: 240px; border-radius: 8px; object-fit: cover; }
        .contact-box { background-color: #f8f9fa; border: 1px solid #e9ecef; }
        
        /* Monospace Bullet Adjustments */
        .custom-bullet li {
            margin-bottom: 0.85rem; 
            font-size: 0.9rem; 
            color: #495057;
        }
        .custom-bullet li::before {
            content: "· "; font-weight: bold; color: #111; margin-right: 6px;
        }
    </style>
</head>
<body class="pb-5">
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-5">
        <div class="container">
            <a class="navbar-brand fw-bold" href="/" style="font-size: 0.95rem;">Siddharth Kalra</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto" style="font-size: 0.9rem;">
                    <li class="nav-item"><a class="nav-link active text-white" href="/">home</a></li>
                    <li class="nav-item"><a class="nav-link" href="/projects">projects</a></li>
                    <li class="nav-item"><a class="nav-link" href="/resume">resume</a></li>
                    <li class="nav-item"><a class="nav-link" href="https://github.com/SiddharthKalra2005" target="_blank" rel="noreferrer">github</a></li>
